# Backend Server
PORT=5001

# Frontend API URL
# VITE_API_URL=http://localhost:5001

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ========================================================
# SUPABASE CONFIGURATION (PostgreSQL Cloud)
# ========================================================
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
# URL: Project URL (contoh: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# KEY: Gunakan 'anon' public key atau 'service_role' secret key
SUPABASE_ANON_KEY=your-anon-or-service-role-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
